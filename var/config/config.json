{
    "roms_root_directory": "/home/pixn/roms",
    "task_logs_directory": "var/task_logs",
    "max_tasks_to_keep": 30,
    "scraper_team": "Team Pixel Nostalgia",
    "server": {
        "host": "0.0.0.0",
        "port": 5001,
        "debug": false
    },
    "logging": {
        "level": "DEBUG",
        "file": "app.log"
    },
    "external_api_token": "na2KJuBQAS3LtW9wnN-62OQf4QjYfIXZQz1bti0_39Q",
    "authentication": {
        "disable_local_auth": true,
        "allow_registration": false
    },
    "media": {
        "scan_settings": {
            "recursive_search": true,
            "case_sensitive": false,
            "auto_update_gamelist": true
        }
    },
    "media_fields": {
        "video": {
            "directory": "videos",
            "extensions": [
                ".mp4"
            ]
        },
        "marquee": {
            "directory": "marquee",
            "target_extension": ".png",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "width": 400
        },
        "boxart": {
            "directory": "box2d",
            "target_extension": ".png",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "height": 900
        },
        "image": {
            "directory": "images",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "target_extension": "",
            "width": 0
        },
        "cartridge": {
            "directory": "cartridges",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "target_extension": ".png",
            "width": 600
        },
        "fanart": {
            "directory": "fanarts",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "target_extension": ".jpg",
            "width": 1920,
            "height": 0
        },
        "titleshot": {
            "directory": "titles",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ]
        },
        "manual": {
            "directory": "manuals",
            "extensions": [
                ".pdf",
                ".cbz"
            ],
            "target_extension": ".pdf"
        },
        "boxback": {
            "directory": "boxback",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "height": 900,
            "target_extension": ".jpg"
        },
        "thumbnail": {
            "directory": "thumbnails",
            "target_extension": ".png",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "height": 900
        },
        "bezel": {
            "directory": "bezels",
            "extensions": [
                ".png"
            ],
            "target_extension": "",
            "width": 0,
            "height": 0
        },
        "spine": {
            "directory": "spine",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "target_extension": ".png",
            "width": 0,
            "height": 0
        },
        "box2_5d": {
            "directory": "box2_5d",
            "extensions": [
                ".png",
                ".jpg",
                ".jpeg"
            ],
            "target_extension": "",
            "width": 0,
            "height": 0
        }
    },
    "2dboxgenerator": {
        "media_field": "boxart",
        "source_fields": {
            "titlescreen": "titleshot",
            "gameplay": "image",
            "logo": "marquee"
        }
    },
    "download": {
        "max_concurrent_downloads": 10,
        "download_timeout": 2,
        "retry_attempts": 5,
        "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
    },
    "similarity": {
        "algorithm": "jaro_winkler",
        "available_algorithms": {
            "jaro_winkler": "Jaro-Winkler Distance",
            "damerau_levenshtein": "Damerau-Levenshtein Distance",
            "levenshtein": "Levenshtein Distance",
            "jaro": "Jaro Distance"
        }
    },
    "video": {
        "force_video_resolution": "720",
        "enable_fadin_fadout": true,
        "enable_cuda": false,
        "enable_youtube_po_token": true,
        "youtube_po_token_provider": "http://127.0.0.1:4416",
        "youtube_skip_cookie_for_video_duration_bigger_than": 200,
        "clip_duration": 30
    }
}