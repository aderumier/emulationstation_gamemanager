#!/bin/bash
set -e

# Post-installation script for GameManager

# Check if this is a fresh installation or upgrade
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    # Fresh installation
    echo "Setting up GameManager..."

    # Create gamemanager user if it doesn't exist
    if ! id "gamemanager" &>/dev/null; then
        echo "Creating gamemanager user..."
        useradd --system --shell /bin/false --home-dir /opt/gamemanager --create-home gamemanager
    fi

    # Set up directories
    echo "Creating application directories..."
    mkdir -p /opt/gamemanager/var/task_logs
    mkdir -p /opt/gamemanager/var/db
    mkdir -p /opt/gamemanager/var/sessions
    mkdir -p /opt/gamemanager/var/config
    mkdir -p /opt/gamemanager/var/cache
    mkdir -p /opt/gamemanager/var/fonts
    mkdir -p /opt/gamemanager/roms
    mkdir -p /opt/gamemanager/var/2dbox/templates
    mkdir -p /opt/gamemanager/var/3dbox/templates
    
    # Handle template files - restore backed up templates if they existed (directory was not empty)
    # If no backups exist (directory was empty), templates from package are already installed
    echo "Checking template directories..."
    if [ -d "/tmp/gamemanager-upgrade/templates/2dbox" ] && [ -n "$(ls -A /tmp/gamemanager-upgrade/templates/2dbox 2>/dev/null)" ]; then
        echo "Restoring existing 2D box templates (directory was not empty before installation)..."
        cp -r /tmp/gamemanager-upgrade/templates/2dbox/* /opt/gamemanager/var/2dbox/templates/ 2>/dev/null || true
        echo "✅ Restored existing 2D box templates (overwrote package templates)"
    else
        echo "✅ 2D box templates directory was empty, templates from package are installed"
    fi
    
    if [ -d "/tmp/gamemanager-upgrade/templates/3dbox" ] && [ -n "$(ls -A /tmp/gamemanager-upgrade/templates/3dbox 2>/dev/null)" ]; then
        echo "Restoring existing 3D box templates (directory was not empty before installation)..."
        cp -r /tmp/gamemanager-upgrade/templates/3dbox/* /opt/gamemanager/var/3dbox/templates/ 2>/dev/null || true
        echo "✅ Restored existing 3D box templates (overwrote package templates)"
    else
        echo "✅ 3D box templates directory was empty, templates from package are installed"
    fi

    # Install default configuration files if they don't exist
    echo "Installing default configuration files..."
    # Files are already in place from package installation
    echo "scrappers.json is ready"
    echo "systems.json is ready"

    # Set permissions
    echo "Setting up permissions..."
    chown -R gamemanager:gamemanager /opt/gamemanager
    chmod 755 /opt/gamemanager
    chmod 755 /opt/gamemanager/var
    chmod 755 /opt/gamemanager/var/task_logs
    chmod 755 /opt/gamemanager/var/db
    chmod 755 /opt/gamemanager/var/sessions
    chmod 755 /opt/gamemanager/var/config
    chmod 755 /opt/gamemanager/var/cache
    chmod 755 /opt/gamemanager/roms

    # Create systemd service file
    echo "Installing systemd service..."
    cat > /etc/systemd/system/gamemanager.service << 'EOF'
[Unit]
Description=GameManager Game Collection Management System
After=network.target

[Service]
Type=exec
User=gamemanager
Group=gamemanager
WorkingDirectory=/opt/gamemanager
Environment=PYTHONPATH=/opt/gamemanager
ExecStart=/usr/bin/python3 app.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamemanager

# Security settings (NoNewPrivileges=no required for Selenium/ChromeDriver)
NoNewPrivileges=no

# Network access (required for Selenium Manager to download ChromeDriver)
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
EOF

    # Reload systemd and enable service
    systemctl daemon-reload
    systemctl enable gamemanager.service

    echo "GameManager installation completed!"
    echo ""
    echo "To start the service:"
    echo "  sudo systemctl start gamemanager"
    echo ""
    echo "To check status:"
    echo "  sudo systemctl status gamemanager"
    echo ""
    echo "To view logs:"
    echo "  sudo journalctl -u gamemanager -f"
    echo ""
    echo "The application will be available at: http://localhost:5000"
    echo ""
    echo "Configuration files are located in: /opt/gamemanager/var/config/"
    echo "Game ROMs should be placed in: /opt/gamemanager/roms/"
    echo "Media files will be stored in: /opt/gamemanager/roms/<system>/media/"

elif [ "$1" = "configure" ] && [ "$2" != "" ]; then
    # Upgrade
    echo "Upgrading GameManager..."
    
    # Ensure gamemanager user exists (in case it was removed)
    if ! id "gamemanager" &>/dev/null; then
        echo "Creating gamemanager user..."
        useradd --system --shell /bin/false --home-dir /opt/gamemanager --create-home gamemanager
    fi
    
    # Ensure directories exist (in case they were removed)
    mkdir -p /opt/gamemanager/var/task_logs
    mkdir -p /opt/gamemanager/var/db
    mkdir -p /opt/gamemanager/var/sessions
    mkdir -p /opt/gamemanager/var/config
    mkdir -p /opt/gamemanager/var/cache
    mkdir -p /opt/gamemanager/roms
    mkdir -p /opt/gamemanager/var/2dbox/templates
    mkdir -p /opt/gamemanager/var/3dbox/templates
    
    # Handle template files - restore backed up templates if they existed (directory was not empty)
    # If no backups exist (directory was empty), templates from package are already installed
    echo "Checking template directories..."
    if [ -d "/tmp/gamemanager-upgrade/templates/2dbox" ] && [ -n "$(ls -A /tmp/gamemanager-upgrade/templates/2dbox 2>/dev/null)" ]; then
        echo "Restoring existing 2D box templates (directory was not empty before installation)..."
        cp -r /tmp/gamemanager-upgrade/templates/2dbox/* /opt/gamemanager/var/2dbox/templates/ 2>/dev/null || true
        echo "✅ Restored existing 2D box templates (overwrote package templates)"
    else
        echo "✅ 2D box templates directory was empty, templates from package are installed"
    fi
    
    if [ -d "/tmp/gamemanager-upgrade/templates/3dbox" ] && [ -n "$(ls -A /tmp/gamemanager-upgrade/templates/3dbox 2>/dev/null)" ]; then
        echo "Restoring existing 3D box templates (directory was not empty before installation)..."
        cp -r /tmp/gamemanager-upgrade/templates/3dbox/* /opt/gamemanager/var/3dbox/templates/ 2>/dev/null || true
        echo "✅ Restored existing 3D box templates (overwrote package templates)"
    else
        echo "✅ 3D box templates directory was empty, templates from package are installed"
    fi
    
    # Clear cache directory on upgrade to ensure clean state
    echo "Clearing cache directory for clean upgrade..."
    if [ -d "/opt/gamemanager/var/cache" ]; then
        rm -rf /opt/gamemanager/var/cache/*
        echo "✅ Cache directory cleared"
    fi
    
    # Clean up old double-nested pyrate_limiter structure if it exists
    if [ -d "/opt/gamemanager/pyrate_limiter/pyrate_limiter" ]; then
        echo "Cleaning up old double-nested pyrate_limiter structure..."
        rm -rf /opt/gamemanager/pyrate_limiter/pyrate_limiter
        echo "Removed old pyrate_limiter/pyrate_limiter directory"
    fi
    
    # Custom conffiles mechanism - check and prompt for configuration file changes
    echo "Checking configuration files for changes..."
    
    # Function to handle configuration file replacement
    handle_config_file() {
        local file_path="$1"
        local file_name=$(basename "$file_path")
        
        if [ -f "$file_path" ]; then
            # Check if we have a backup from preinst
            local backup_file="/tmp/gamemanager-upgrade/$file_name.backup"
            if [ -f "$backup_file" ]; then
                # Compare backup with current file
                local old_checksum=$(md5sum "$backup_file" | cut -d' ' -f1)
                local new_checksum=$(md5sum "$file_path" | cut -d' ' -f1)
                
                if [ "$old_checksum" != "$new_checksum" ]; then
                echo ""
                echo "Configuration file '$file_path' has been modified since installation."
                echo "Package distributor has shipped an updated version."
                echo ""
                echo "What would you like to do about it?"
                echo "  Y or I  : install the package maintainer's version"
                echo "  N or O  : keep your currently-installed version"
                echo "  D       : show the differences between the versions"
                echo ""
                echo -n "Your choice [Y/I/N/O/D]: "
                read -r choice
                
                    case "$choice" in
                        [YyIi])
                            echo "Installing new version of $file_name..."
                            echo "✅ $file_name updated"
                            ;;
                        [NnOo])
                            echo "Restoring original version of $file_name..."
                            # Restore the original file from backup
                            if [ -f "$backup_file" ]; then
                                if cp "$backup_file" "$file_path" 2>/dev/null; then
                                    echo "✅ $file_name restored to original version"
                                else
                                    echo "⚠️  Could not restore original file, keeping new version"
                                fi
                            else
                                echo "⚠️  Could not restore original file, keeping new version"
                            fi
                            ;;
                        [Dd])
                            echo "Showing differences for $file_name:"
                            echo "--- Original version (left) vs New version (right) ---"
                            if [ -f "$backup_file" ]; then
                                diff -u "$backup_file" "$file_path" || true
                            else
                                echo "Could not show differences - original file not found"
                            fi
                            echo ""
                            echo -n "Do you want to install the new version? [Y/N]: "
                            read -r diff_choice
                            case "$diff_choice" in
                                [Yy])
                                    echo "✅ $file_name updated"
                                    ;;
                                *)
                                    echo "Restoring original version of $file_name..."
                                    if [ -f "$backup_file" ]; then
                                        if cp "$backup_file" "$file_path" 2>/dev/null; then
                                            echo "✅ $file_name restored to original version"
                                        else
                                            echo "⚠️  Could not restore original file, keeping new version"
                                        fi
                                    else
                                        echo "⚠️  Could not restore original file, keeping new version"
                                    fi
                                    ;;
                            esac
                            ;;
                        *)
                            echo "Invalid choice. Keeping new version of $file_name"
                            ;;
                    esac
                else
                    echo "✅ $file_name is up to date"
                fi
            else
                echo "⚠️  No stored checksum found for $file_name, assuming it's new"
            fi
        else
            echo "Installing new configuration file: $file_name"
        fi
    }
    
    # Handle each configuration file
    handle_config_file "/opt/gamemanager/var/config/config.json"
    handle_config_file "/opt/gamemanager/var/config/scrappers.json"
    handle_config_file "/opt/gamemanager/var/config/systems.json"
    
    # Clean up temporary checksum files
    echo "Cleaning up temporary files..."
    rm -rf /tmp/gamemanager-upgrade
    
    
    

    if [ -f /opt/gamemanager/var/config/user.cfg ]; then
        cp /opt/gamemanager/var/config/user.cfg /opt/gamemanager/var/config/user.cfg.backup
    fi
    
    # Set permissions
    chown -R gamemanager:gamemanager /opt/gamemanager
    chmod 755 /opt/gamemanager
    chmod 755 /opt/gamemanager/var
    chmod 755 /opt/gamemanager/var/task_logs
    chmod 755 /opt/gamemanager/var/db
    chmod 755 /opt/gamemanager/var/sessions
    chmod 755 /opt/gamemanager/var/config
    chmod 755 /opt/gamemanager/var/cache
    chmod 755 /opt/gamemanager/roms

    # Update systemd service file
    echo "Updating systemd service..."
    cat > /etc/systemd/system/gamemanager.service << 'EOF'
[Unit]
Description=GameManager Game Collection Management System
After=network.target

[Service]
Type=exec
User=gamemanager
Group=gamemanager
WorkingDirectory=/opt/gamemanager
Environment=PYTHONPATH=/opt/gamemanager
ExecStart=/usr/bin/python3 app.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamemanager

# Security settings (NoNewPrivileges=no required for Selenium/ChromeDriver)
NoNewPrivileges=no

# Network access (required for Selenium Manager to download ChromeDriver)
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
EOF

    if [ -f /opt/gamemanager/var/config/user.cfg.backup ]; then
        mv /opt/gamemanager/var/config/user.cfg.backup /opt/gamemanager/var/config/user.cfg
        echo "Restored existing user.cfg"
    fi
    
    
    # Reload systemd
    systemctl daemon-reload
    
    # Restart service if it was enabled (it was stopped by prerm during upgrade)
    # Check if service is enabled - if so, restart it regardless of current state
    if systemctl is-enabled --quiet gamemanager 2>/dev/null; then
        echo "GameManager service is enabled, restarting..."
        systemctl restart gamemanager || systemctl start gamemanager
        echo "✅ GameManager service restarted."
    else
        echo "GameManager service is not enabled, skipping restart."
        echo "To enable and start the service: sudo systemctl enable --now gamemanager"
    fi

    echo "GameManager upgrade completed!"
    echo "Configuration and data directories preserved."
    echo "Service has been updated and restarted if it was running."

else
    echo "GameManager post-installation script completed."
fi

exit 0

