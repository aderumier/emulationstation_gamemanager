#!/bin/bash
set -e

# Pre-installation script for GameManager
# Store original configuration file checksums before package installation

echo "Storing original configuration file checksums..."

# Create temporary directory for checksums
mkdir -p /tmp/gamemanager-upgrade

# Backup existing configuration files
if [ -f "/opt/gamemanager/var/config/config.json" ]; then
    cp "/opt/gamemanager/var/config/config.json" "/tmp/gamemanager-upgrade/config.json.backup"
    echo "Backed up config.json"
fi

if [ -f "/opt/gamemanager/var/config/scrappers.json" ]; then
    cp "/opt/gamemanager/var/config/scrappers.json" "/tmp/gamemanager-upgrade/scrappers.json.backup"
    echo "Backed up scrappers.json"
fi

if [ -f "/opt/gamemanager/var/config/systems.json" ]; then
    cp "/opt/gamemanager/var/config/systems.json" "/tmp/gamemanager-upgrade/systems.json.backup"
    echo "Backed up systems.json"
fi

echo "GameManager pre-installation script completed."

exit 0
