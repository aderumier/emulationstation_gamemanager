		<video>./media/videos/Archon - The Light and the Dark.mp4</video>
		<manual>./media/manuals/Archon_ The Light and the Dark.pdf</manual>
		<boxback>./media/boxback/Archon_ The Light and the Dark-01.jpg</boxback>
	</game>
