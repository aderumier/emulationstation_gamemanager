	<game>
		<path>./2-best/Buck Rogers - Countdown to Doomsday.crt</path>
		<name>Buck Rogers - Countdown to Doomsday</name>
		<sortname>0415 =-  Buck Rogers - Countdown to Doomsday</sortname>
		<genreid>0</genreid>
		<hidden>true</hidden>
